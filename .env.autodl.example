# AutoDL persistent storage. Copy this file to .env and adjust only if your
# instance mounts its persistent volume elsewhere. .env is ignored by git.
PERSIST_ROOT=/root/autodl-tmp/ecomq
DATA_ROOT=$PERSIST_ROOT/data
MODEL_ROOT=$PERSIST_ROOT/models
OUTPUT_ROOT=$PERSIST_ROOT/outputs
HF_HOME=$PERSIST_ROOT/hf_cache

# Optional Hugging Face settings. Never commit a token.
HF_ENDPOINT=https://huggingface.co
HF_TOKEN=
