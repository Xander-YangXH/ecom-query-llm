# CCDS GPU Cluster TC2：复制为 .env 后使用（.env 不进 git）。
# 数据与计算都限制在家目录内，配额约 100GB，请勿访问其他用户的目录。
DATA_ROOT=$HOME/ecomq/data
MODEL_ROOT=$HOME/ecomq/models
OUTPUT_ROOT=$HOME/ecomq/outputs
HF_HOME=$HOME/ecomq/hf_cache

# 数据合成用的 OpenAI 兼容接口（可选；建议在你自己的电脑上合成，再把 jsonl 传上来）
SYNTH_BASE_URL=
SYNTH_API_KEY=
SYNTH_MODEL=
