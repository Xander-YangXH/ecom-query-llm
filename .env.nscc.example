# NSCC ASPIRE2A：复制为 .env 后使用（.env 不进 git）。
# 家目录只有 50GB，数据、模型、产出和 conda 环境都放个人 scratch（~/scratch 是指向它的链接）。
ECOMQ_ROOT=$HOME/scratch/ecomq
DATA_ROOT=$ECOMQ_ROOT/data
MODEL_ROOT=$ECOMQ_ROOT/models
OUTPUT_ROOT=$ECOMQ_ROOT/outputs
HF_HOME=$ECOMQ_ROOT/hf_cache
# conda 环境的位置（scripts/setup_env_nscc.sh 创建；PBS 作业把它的 bin 放到 PATH 最前）
ENV_PREFIX=$ECOMQ_ROOT/env
# CUDA 工具包（nvcc），安装 DeepSpeed 和 DeepSpeed 的作业要用；集群上的路径用 ls /app/apps/cuda 查
CUDA_HOME=/app/apps/cuda/12.8.1
# 提交作业必须带项目号（myprojects 可查）；写在这里，不写进作业脚本
NSCC_PROJECT=<your-project-id>
