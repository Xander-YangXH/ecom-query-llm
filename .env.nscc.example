MODEL_ROOT=/path/to/large/storage/ecom-query-llm/models
OUTPUT_ROOT=/path/to/large/storage/ecom-query-llm/outputs
HF_HOME=/path/to/large/storage/ecom-query-llm/hf_cache

SYNTH_BASE_URL=
SYNTH_API_KEY=
SYNTH_MODEL=
