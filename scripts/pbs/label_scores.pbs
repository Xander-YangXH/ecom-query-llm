#!/bin/bash
# 计算 relevance 四个候选标签的对数概率，对应 scripts/slurm/label_scores.sbatch。
#   scripts/pbs/submit.sh label_scores MODEL=Qwen2.5-7B-Instruct RUN=<适配器> TEST=<jsonl> NAME=<结果名> LOAD_4BIT=1
# 输出：$OUTPUT_ROOT/label_scores/$NAME.jsonl。RUN 留空：给基座打分。DOUBLE_QUANT=1：与 N1 的打分协议一致（S27）。
#PBS -N ecomq-lblscore
#PBS -q normal
#PBS -l select=1:ncpus=16:ngpus=1:mem=110gb
#PBS -l walltime=01:30:00
#PBS -j oe
#PBS -o logs/
set -eo pipefail
source "${PBS_O_WORKDIR:?}/scripts/pbs/common.sh"
: "${MODEL:?}"; : "${TEST:?}"; : "${NAME:?}"

ARGS=(--model "$MODEL_ROOT/$MODEL" --test "$TEST"
      --output "$OUTPUT_ROOT/label_scores/$NAME.jsonl" --batch-size "${BATCH_SIZE:-32}")
[ -n "${RUN:-}" ] && ARGS+=(--lora "$OUTPUT_ROOT/$RUN")
[ -n "${TASK:-}" ] && ARGS+=(--task "$TASK")
[ -n "${LOAD_4BIT:-}" ] && ARGS+=(--load-4bit)
[ -n "${DOUBLE_QUANT:-}" ] && ARGS+=(--double-quant)
START=$SECONDS
python -m ecomq.eval.score_labels "${ARGS[@]}"
echo "score_labels: $((SECONDS - START))s"
